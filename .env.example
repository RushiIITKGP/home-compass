# Copy to .env and fill in the blanks:  cp .env.example .env
# Only GROQ_API_KEY is strictly required. Everything else has a working
# default or is optional.

# --- Database (a local default; leave as-is for Docker) ---
POSTGRES_USER=homecompass
POSTGRES_PASSWORD=homecompass
POSTGRES_DB=homecompass
DATABASE_URL=postgresql+psycopg://homecompass:homecompass@localhost:5432/homecompass

# --- Chat model (provider:model — see api/llm.py) ---
# Free Groq key (no card): https://console.groq.com
CHAT_MODEL=groq:llama-3.3-70b-versatile
GROQ_API_KEY=
# Alternatives you can switch to with one line:
# CHAT_MODEL=ollama:qwen3.5:9b            (fully local, needs Ollama)
# CHAT_MODEL=google_genai:gemini-3.1-flash-lite-preview  (needs GEMINI_API_KEY)

# --- Embeddings: local via Ollama (https://ollama.com) ---
#   ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_DIM=768

# --- Optional chat fallback ---
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# --- Agent tuning ---
CONFIDENCE_THRESHOLD=0.8
CONTEXT_WINDOW_TURNS=8
ANSWER_SCORING=true
ANSWER_CONFIDENCE_THRESHOLD=0.75

# --- Free enrichment data sources ---
# Census: https://api.census.gov/data/key_signup.html
# FBI (via api.data.gov): https://api.data.gov/signup
CENSUS_API_KEY=
FBI_API_KEY=

# --- Compliance guardrail rulebook (Google Drive, optional) ---
# One-time OAuth setup in compliance/README.md; point this at the folder
# holding gcp-oauth.keys.json. Without it, the guardrail is simply OFF.
GDRIVE_CREDS_DIR=

# --- Observability (optional) ---
# Free LangSmith key: https://smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=home-compass
LANGCHAIN_TRACING_V2=true
